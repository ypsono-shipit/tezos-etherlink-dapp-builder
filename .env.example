# Form storage. Unset or "log" prints submissions and does not persist them.
# "noop" accepts the submission and discards the payload.
# "sheets", "notion", and "postgres" persist when their env vars are set.
FORM_STORAGE=log

# Optional salt for the stored IP hash. Set this before production traffic.
IP_HASH_SALT=

# Optional distributed rate limit. Without these, each function instance keeps its own memory window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Sheets (FORM_STORAGE=sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
# Boundless applications still append to this tab. Do not rename it.
GOOGLE_SHEETS_CLAUDE_TAB=claude_applications
GOOGLE_SHEETS_PARTNER_TAB=partner_applications

# Notion (FORM_STORAGE=notion)
NOTION_TOKEN=
NOTION_CLAUDE_DATABASE_ID=
NOTION_PARTNER_DATABASE_ID=

# Postgres (FORM_STORAGE=postgres). The function creates the tables on first write.
DATABASE_URL=
